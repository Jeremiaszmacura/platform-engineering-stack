      {
        "id": 9,
        "title": "Availability SLI",
        "type": "stat",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "description": "Share of API requests in the selected time range that did not fail with a 5XX (probes and scrapes excluded).",
        "targets": [
          {
            "expr": "1 - (sum(increase(http_requests_total{job=\"stock-app\",status_code=~\"5..\"}[$__range])) or vector(0)) / clamp_min(sum(increase(http_requests_total{job=\"stock-app\"}[$__range])), 0.0001)",
            "refId": "A",
            "legendFormat": "Availability SLI",
            "datasource": {
              "type": "prometheus",
              "uid": "prometheus"
            }
          }
        ],
        "gridPos": {
          "h": 5,
          "w": 4,
          "x": 0,
          "y": 1
        },
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "unit": "percentunit",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "red",
                  "value": null
                },
                {
                  "color": "orange",
                  "value": 0.95
                },
                {
                  "color": "green",
                  "value": 0.99
                }
              ]
            },
            "min": 0,
            "max": 1,
            "decimals": 2
          }
        },
        "options": {
          "colorMode": "value",
          "graphMode": "area",
          "justifyMode": "auto",
          "orientation": "auto",
          "reduceOptions": {
            "values": false,
            "calcs": [
              "lastNotNull"
            ],
            "fields": ""
          }
        }
      },
      {
        "id": 10,
