            "expr": "1 - (sum(increase(http_request_duration_seconds_count{job=\"stock-app\"}[$__range])) - sum(increase(http_request_duration_seconds_bucket{job=\"stock-app\",le=\"1.0\"}[$__range]))) / clamp_min(sum(increase(http_request_duration_seconds_count{job=\"stock-app\"}[$__range])), 0.0001)",
