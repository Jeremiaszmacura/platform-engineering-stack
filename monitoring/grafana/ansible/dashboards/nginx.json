{
  "dashboard": {
    "id": null,
    "title": "NGINX Monitoring",
    "tags": [
      "nginx",
      "monitoring"
    ],
    "timezone": "browser",
    "panels": [
      {
        "id": 1,
        "title": "NGINX Pods Up",
        "type": "stat",
        "targets": [
          {
            "expr": "sum(nginx_up)",
            "legendFormat": "Pods up",
            "refId": "A",
            "datasource": {
              "type": "prometheus",
              "uid": "prometheus"
            }
          }
        ],
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "red",
                  "value": null
                },
                {
                  "color": "green",
                  "value": 1
                }
              ]
            }
          }
        },
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 0
        },
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        }
      },
      {
        "id": 2,
        "title": "Active Connections",
        "type": "stat",
        "targets": [
          {
            "expr": "sum(nginx_connections_active)",
            "legendFormat": "Active",
            "refId": "A",
            "datasource": {
              "type": "prometheus",
              "uid": "prometheus"
            }
          }
        ],
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 0
        },
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        }
      },
      {
        "id": 3,
        "title": "Request Rate",
        "type": "timeseries",
        "targets": [
          {
            "expr": "sum by (instance) (rate(nginx_http_requests_total[5m]))",
            "legendFormat": "{{instance}}",
            "refId": "A",
            "datasource": {
              "type": "prometheus",
              "uid": "prometheus"
            }
          }
        ],
        "gridPos": {
          "h": 9,
          "w": 24,
          "x": 0,
          "y": 8
        },
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        }
      },
      {
        "id": 5,
        "title": "Connection States",
        "type": "timeseries",
        "targets": [
          {
            "expr": "sum(nginx_connections_reading)",
            "legendFormat": "Reading",
            "refId": "A",
            "datasource": {
              "type": "prometheus",
              "uid": "prometheus"
            }
          },
          {
            "expr": "sum(nginx_connections_writing)",
            "legendFormat": "Writing",
            "refId": "B",
            "datasource": {
              "type": "prometheus",
              "uid": "prometheus"
            }
          },
          {
            "expr": "sum(nginx_connections_waiting)",
            "legendFormat": "Waiting",
            "refId": "C",
            "datasource": {
              "type": "prometheus",
              "uid": "prometheus"
            }
          }
        ],
        "gridPos": {
          "h": 9,
          "w": 24,
          "x": 0,
          "y": 17
        },
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        }
      }
    ],
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "refresh": "30s",
    "uid": "nginx"
  },
  "overwrite": true
}
