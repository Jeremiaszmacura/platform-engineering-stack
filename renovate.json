{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "schedule": ["before 6am"],
  "minimumReleaseAge": "3 days",
  "postUpdateOptions": ["gomodTidy"],
  "ignoreDeps": ["cluster-map", "documentation", "traffic-generator", "stock-app", "stock-ui"],
  "pre-commit": {
    "enabled": true
  },
  "kubernetes": {
    "managerFilePatterns": ["/(^|/)k8s/.+\\.ya?ml$/"]
  },
  "customManagers": [
    {
      "description": "Envoy Gateway release manifest URL in its kustomization",
      "customType": "regex",
      "managerFilePatterns": ["/^platform/envoy-gateway/kustomization\\.yaml$/"],
      "matchStrings": ["envoyproxy/gateway/releases/download/v(?<currentValue>\\d+\\.\\d+\\.\\d+)/"],
      "depNameTemplate": "envoyproxy/gateway",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.+)$"
    },
    {
      "description": "kind version installed in the e2e workflow (it decides the Kubernetes version CI runs)",
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/e2e\\.yaml$/"],
      "matchStrings": ["kind-action@v\\d+\\s+with:\\s+version: v(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      "depNameTemplate": "kubernetes-sigs/kind",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.+)$"
    },
    {
      "description": "golangci-lint version installed in CI",
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/go-qa\\.yaml$/"],
      "matchStrings": ["golangci-lint@v(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      "depNameTemplate": "golangci/golangci-lint",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.+)$"
    }
  ],
  "packageRules": [
    {
      "description": "Merge minor, patch and digest updates automatically once CI is green",
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "automerge": true
    },
    {
      "description": "OpenTelemetry's Python SDK and instrumentations are released together and must match",
      "matchDatasources": ["pypi"],
      "matchPackageNames": ["opentelemetry-*"],
      "groupName": "OpenTelemetry Python"
    },
    {
      "description": "Language runtimes must stay in sync with the versions set in .github/workflows, so a human merges them",
      "matchDepNames": ["python", "golang", "node", "go"],
      "automerge": false
    }
  ]
}
